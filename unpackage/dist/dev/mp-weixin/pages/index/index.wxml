<view id="{{y}}" change:eS="{{uV.sS}}" eS="{{$eS[y]}}" change:eA="{{uV.sA}}" eA="{{$eA[y]}}" class="{{['container', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><scroll-view class="scroll-content" scroll-y="true" enable-flex="true" enhanced="true"><view class="form"><view class="form-item"><text class="label">目标人物姓名</text><input class="input" placeholder="请输入姓名" placeholder-class="placeholder" value="{{a}}" bindinput="{{b}}"/></view><view class="form-item"><text class="label">照片（选填）</text><view class="photo-upload" bindtap="{{e}}"><image wx:if="{{c}}" class="photo-preview" src="{{d}}"></image><view wx:else class="photo-placeholder"><text class="photo-text">点击上传照片</text></view></view></view><view class="form-item"><text class="label">与我的关系</text><text class="hint">请按顺序选择关系路径</text></view><view wx:if="{{f}}" class="relation-path"><text class="path-text">当前路径：</text><view class="path-items"><text wx:for="{{g}}" wx:for-item="item" wx:key="c" class="path-item">{{item.a}} <text wx:if="{{item.b}}" class="arrow"> → </text></text></view><view class="clear-btn" bindtap="{{h}}"><text class="clear-text">撤销上一步</text></view></view><view class="relation-buttons"><view wx:if="{{i}}" class="button-row"><view class="relation-btn" bindtap="{{j}}"><text>爸爸</text></view><view class="relation-btn" bindtap="{{k}}"><text>妈妈</text></view></view><view wx:if="{{l}}" class="button-row"><view class="relation-btn" bindtap="{{m}}"><text>哥哥</text></view><view class="relation-btn" bindtap="{{n}}"><text>弟弟</text></view><view class="relation-btn" bindtap="{{o}}"><text>姐姐</text></view><view class="relation-btn" bindtap="{{p}}"><text>妹妹</text></view></view><view wx:if="{{q}}" class="button-row"><view class="relation-btn" bindtap="{{r}}"><text>儿子</text></view><view class="relation-btn" bindtap="{{s}}"><text>女儿</text></view></view></view><view class="action-buttons"><view class="btn btn-secondary" bindtap="{{t}}"><text>重置</text></view><view class="btn btn-primary" bindtap="{{v}}"><text>计算称呼</text></view></view><view wx:if="{{w}}" class="result"><text class="result-label">计算结果：</text><text class="result-title">{{x}}</text></view></view></scroll-view></view><wxs src="/common/uniView.wxs" module="uV"/>
