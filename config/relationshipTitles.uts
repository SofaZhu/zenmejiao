// 北方方言（姥姥、姥爷）
export const northernChinese: RelationshipConfig = {
	...standardChinese,
	maternalGrandfather: { title: '姥爷', description: '外祖父' },
	maternalGrandmother: { title: '姥姥', description: '外祖母' },
}

// 当前使用的称呼配置
export let currentConfig: RelationshipConfig = standardChinese

// 切换称呼配置
export function setRelationshipConfig(config: RelationshipConfig) {
	currentConfig = config
}

// 获取当前称呼配置
export function getRelationshipConfig(): RelationshipConfig {
	return currentConfig
}
