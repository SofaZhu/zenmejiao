// 亲戚关系称呼配置
// 支持不同方言地区的称呼

export type RelationshipTitle = {
	title: string
	description: string
}

export type RelationshipConfig = {
	// 祖辈 - 父系
	grandfather: RelationshipTitle // 爷爷
	grandmother: RelationshipTitle // 奶奶
	grandfatherOlderBrother: RelationshipTitle // 伯祖父
	grandfatherYoungerBrother: RelationshipTitle // 叔祖父
	grandfatherSister: RelationshipTitle // 姑婆
	grandmotherBrother: RelationshipTitle // 舅公
	grandmotherSister: RelationshipTitle // 姨婆

	// 祖辈 - 母系
	maternalGrandfather: RelationshipTitle // 外公
	maternalGrandmother: RelationshipTitle // 外婆
	maternalGrandfatherBrother: RelationshipTitle // 舅公
	maternalGrandfatherSister: RelationshipTitle // 姑婆
	maternalGrandmotherBrother: RelationshipTitle // 舅公
	maternalGrandmotherSister: RelationshipTitle // 姨婆

	// 父辈 - 父系
	father: RelationshipTitle // 爸爸
	fatherOlderBrother: RelationshipTitle // 伯父
	fatherYoungerBrother: RelationshipTitle // 叔父
	fatherSister: RelationshipTitle // 姑妈

	// 父辈 - 母系
	mother: RelationshipTitle // 妈妈
	motherBrother: RelationshipTitle // 舅舅
	motherSister: RelationshipTitle // 姨妈

	// 同辈
	olderBrother: RelationshipTitle // 哥哥
	youngerBrother: RelationshipTitle // 弟弟
	olderSister: RelationshipTitle // 姐姐
	youngerSister: RelationshipTitle // 妹妹

	// 堂表兄弟姐妹
	olderCousinBrotherPaternal: RelationshipTitle // 堂哥
	youngerCousinBrotherPaternal: RelationshipTitle // 堂弟
	olderCousinSisterPaternal: RelationshipTitle // 堂姐
	youngerCousinSisterPaternal: RelationshipTitle // 堂妹

	olderCousinBrotherMaternal: RelationshipTitle // 表哥
	youngerCousinBrotherMaternal: RelationshipTitle // 表弟
	olderCousinSisterMaternal: RelationshipTitle // 表姐
	youngerCousinSisterMaternal: RelationshipTitle // 表妹

	// 子辈
	son: RelationshipTitle // 儿子
	daughter: RelationshipTitle // 女儿
	nephew: RelationshipTitle // 侄子
	niece: RelationshipTitle // 侄女
	nephewFromSister: RelationshipTitle // 外甥
	nieceFromSister: RelationshipTitle // 外甥女

	// 孙辈
	grandson: RelationshipTitle // 孙子
	granddaughter: RelationshipTitle // 孙女
	maternalGrandson: RelationshipTitle // 外孙
	maternalGranddaughter: RelationshipTitle // 外孙女
}

