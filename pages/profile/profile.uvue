<template>
	<view class="container">
		<view class="content">
			<!-- 头像 -->
			<view class="avatar-section">
				<image
					v-if="userPhoto"
					class="avatar-large"
					:src="userPhoto"
				></image>
				<view v-else class="avatar-large-placeholder">
					<text class="avatar-text">{{ userName ? userName.substring(0, 1) : '我' }}</text>
				</view>
				<view class="upload-btn" @click="choosePhoto">
					<text class="upload-text">{{ userPhoto ? '更换照片' : '上传照片' }}</text>
				</view>
			</view>

			<!-- 姓名 -->
			<view class="form-section">
				<view class="form-item">
					<text class="label">姓名</text>
					<input
						class="input"
						v-model="userName"
						placeholder="请输入您的姓名"
						placeholder-class="placeholder"
					/>
				</view>

				<!-- 性别 -->
				<view class="form-item">
					<text class="label">性别</text>
					<view class="radio-group">
						<view
							class="radio-item"
							:class="userGender === 'male' ? 'active' : ''"
							@click="userGender = 'male'"
						>
							<text class="radio-text">男</text>
						</view>
						<view
							class="radio-item"
							:class="userGender === 'female' ? 'active' : ''"
							@click="userGender = 'female'"
						>
							<text class="radio-text">女</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 保存按钮 -->
			<view class="save-btn" @click="saveProfile">
				<text class="save-text">保存</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import { getUserProfile, saveUserProfile } from '../../utils/storage.uts'
	import { generateId } from '../../utils/relationshipCalculator.uts'
	import type { UserProfile, Gender } from '../../types/family.uts'

	const userName = ref('')
	const userPhoto = ref('')
	const userGender = ref<Gender>('male')

	onMounted(() => {
		loadProfile()
	})

	function loadProfile() {
		const profile = getUserProfile()
		if (profile) {
			userName.value = profile.name
			userPhoto.value = profile.photo
			userGender.value = profile.gender
		}
	}

	function choosePhoto() {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				userPhoto.value = res.tempFilePaths[0]
			}
		})
	}

	function saveProfile() {
		if (!userName.value) {
			uni.showToast({
				title: '请输入姓名',
				icon: 'none'
			})
			return
		}

		const profile: UserProfile = {
			id: generateId(),
			name: userName.value,
			photo: userPhoto.value,
			gender: userGender.value
		}

		saveUserProfile(profile)

		uni.showToast({
			title: '保存成功',
			icon: 'success'
		})

		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}
</script>

<style>
	.container {
		min-height: 100vh;
		background-color: #f5f5f5;
	}

	.header {
		padding: 20px;
		background-color: #fff;
		text-align: center;
		border-bottom: 1px solid #eee;
	}

	.title {
		font-size: 20px;
		font-weight: bold;
		color: #333;
	}

	.content {
		padding: 20px;
	}

	.avatar-section {
		align-items: center;
		margin-bottom: 30px;
		padding: 30px 0;
		background-color: #fff;
		border-radius: 10px;
	}

	.avatar-large {
		width: 100px;
		height: 100px;
		border-radius: 50px;
		margin-bottom: 15px;
	}

	.avatar-large-placeholder {
		width: 100px;
		height: 100px;
		border-radius: 50px;
		background-color: #e0e0e0;
		align-items: center;
		justify-content: center;
		margin-bottom: 15px;
	}

	.avatar-text {
		font-size: 36px;
		color: #666;
		font-weight: bold;
	}

	.upload-btn {
		padding: 8px 20px;
		background-color: #007aff;
		border-radius: 20px;
	}

	.upload-text {
		font-size: 14px;
		color: #fff;
	}

	.form-section {
		background-color: #fff;
		border-radius: 10px;
		padding: 20px;
		margin-bottom: 20px;
	}

	.form-item {
		margin-bottom: 20px;
	}

	.label {
		font-size: 16px;
		color: #333;
		margin-bottom: 10px;
		display: block;
	}

	.input {
		width: 100%;
		height: 45px;
		border: 1px solid #ddd;
		border-radius: 5px;
		padding: 0 15px;
		font-size: 14px;
	}

	.placeholder {
		color: #ccc;
	}

	.radio-group {
		flex-direction: row;
		gap: 15px;
	}

	.radio-item {
		padding: 10px 20px;
		border: 1px solid #ddd;
		border-radius: 5px;
		background-color: #fff;
	}

	.radio-item.active {
		background-color: #007aff;
		border-color: #007aff;
	}

	.radio-text {
		font-size: 14px;
		color: #333;
	}

	.radio-item.active .radio-text {
		color: #fff;
	}

	.save-btn {
		width: 100%;
		height: 50px;
		background-color: #007aff;
		border-radius: 10px;
		align-items: center;
		justify-content: center;
	}

	.save-text {
		font-size: 16px;
		color: #fff;
		font-weight: bold;
	}
</style>
